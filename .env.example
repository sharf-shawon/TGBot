# Telegram Bot Configuration
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_BOT_NAME=YourBotName
TG_BOT_USERNAME=your_bot_username
TG_BOT_OWNER_ID=123456789

# Admin User IDs (comma-separated list of Telegram user IDs)
# These users can add/remove other users and have full access
ADMIN_USER_IDS=123456789

# OpenRouter Configuration (Optional)
# If set, users won't need to provide their own API key
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-flash-1.5:free
# Note: If OPENROUTER_MODEL is not set, the bot will automatically use
# the first free model available from OpenRouter's API

# PostgreSQL Database Connection
# Format: postgresql://username:password@host:port/database
POSTGRES_URL=postgresql://user:password@localhost:5432/database

# Data directory for persistent storage
# Optional - defaults to ./data for local development
# DATA_DIR=./data
